# ═══════════════════════════════════════════════════════════
# إعدادات المنصة (اختيارية — لو ما حطيتها بيستخدم القيم الافتراضية داخل الكود)
# ═══════════════════════════════════════════════════════════

# منفذ الموقع
PORT=3000

# مفتاح توقيع جلسات لوحة التحكم (غيّره لأي نص عشوائي طويل)
SESSION_SECRET=change-this-to-a-long-random-string

# ── مفاتيح البوت (لو حطيتها هون بتتجاوز القيم المكتوبة بالكود) ──
# GEMINI_API_KEY=
# VERIFY_TOKEN=talebbot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── اختيار دماغ البوت ──
# AI_PROVIDER=openai        # أو gemini (فاضي = تلقائي حسب المفتاح المتوفر)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# مسار قاعدة البيانات المحلية
DB_PATH=./data/platform.db

# ── التخزين الدائم عبر Turso (عشان الأوردرات ما تنمسح أبداً) ──
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# ── مستخدم لوحة التحكم (يُنشأ تلقائياً أول تشغيل) ──
ADMIN_USER=admin
ADMIN_PASS=change-this-strong-password

# ═══════════════════════════════════════════════════════════
# 🔑 توكنات صفحات فيسبوك — الطريقة الآمنة
#
# الصيغة: PAGE_TOKEN_<معرّف الصفحة>
# بتدعس التوكن المكتوب بالكود وبتوكن قاعدة البيانات.
#
# ليش هيك: التوكن المكتوب بالكود بينرفع للمستودع. لو المستودع
# عام، GitHub بيرصده ويبلّغ ميتا، وميتا بتلغيه خلال ساعات.
# متغيّر البيئة بيضل بلوحة الاستضافة وما بينرفع لأي مكان.
#
# على Render: Dashboard ← خدمتك ← Environment ← Add Environment Variable
# ═══════════════════════════════════════════════════════════
# PAGE_TOKEN_1097322276797532=   # اجبان المهيري
# PAGE_TOKEN_446086435262675=    # الحلال الابيض
# PAGE_TOKEN_211000052105556=    # أجبان غزة
# PAGE_TOKEN_907535882452054=    # اجبان المعتمد
# PAGE_TOKEN_1271513032713402=   # منتجات أم نزار
# PAGE_TOKEN_618622274665182=    # ريفان لمواد التنظيف
